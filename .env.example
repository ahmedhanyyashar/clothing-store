# Copy to .env. src/env.ts is the source of truth: it validates every
# variable below at startup and fails fast on anything missing or malformed.

# Public URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (the `database` service in docker/compose.yaml)
DATABASE_URL="postgresql://root:password@localhost:5432/clothing_store"

# Email: the `mail` service in docker/compose.yaml catches everything sent
# locally. Open http://localhost:8025 to read it.
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="no-reply@clothing-store.example"

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Google sign-in: create OAuth credentials in the Google Cloud console and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
