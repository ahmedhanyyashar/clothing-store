# Copy to .env. src/env.ts is the source of truth: it validates every
# variable below at startup and fails fast on anything missing or malformed.

# Public URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (the `database` service in docker/compose.yaml)
DATABASE_URL="postgresql://root:password@localhost:5432/clothing_store"

# Email: the `mail` service in docker/compose.yaml catches everything sent
# locally. Open http://localhost:8025 to read it.
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="no-reply@clothing-store.example"

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Google sign-in: create OAuth credentials in the Google Cloud console and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Stripe (test mode). Create a free account, switch to test mode, and copy the
# secret key from Developers > API keys.
STRIPE_SECRET_KEY="sk_test_replace-me"
# Forward Stripe's events to this app with the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# It prints the signing secret (whsec_...) to use here.
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
# Optional: use the local stand-in server (the `stripe-mock` service) instead of
# Stripe. Payments cannot be completed against it; it only answers requests.
# STRIPE_API_URL="http://localhost:12111"

# Product photos (S3). Locally, the `storage` service in docker/compose.yaml
# stands in for S3; create the bucket with `pnpm storage:setup`.
S3_BUCKET="clothing-store-dev"
S3_REGION="us-east-1"
S3_ENDPOINT_URL="http://localhost:4566"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
# Optional: serve photos from another address than the bucket's own.
# S3_PUBLIC_URL="https://images.example.com"

# Optional: the password of the demo accounts made by `pnpm db:seed:demo`.
# DEMO_PASSWORD="choose-a-demo-password"

# Optional: show "use a demo account" on the sign-in page. Needs DEMO_PASSWORD
# and the accounts made by `pnpm db:seed:demo`.
# DEMO_MODE="true"
