# Copy to .env. src/env.ts is the source of truth: it validates every
# variable below at startup and fails fast on anything missing or malformed.

# Public URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (the `database` service in docker/compose.yaml)
DATABASE_URL="postgresql://root:password@localhost:5432/clothing_store"

# Email: the `mail` service in docker/compose.yaml catches everything sent
# locally. Open http://localhost:8025 to read it.
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="no-reply@clothing-store.example"
