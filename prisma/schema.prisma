generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
}

// Where the money is. Pending means not paid yet: a card payment in progress,
// or cash still to be collected on delivery.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  // The public demo accounts: they can look around but not change anything
  // that matters. Set only by the demo seed.
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  orders        Order[]
  auditEntries  AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Backs Better Auth's request rate limiter, so limits hold across instances.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rate_limit")
}

enum Category {
  MEN
  WOMEN
  CHILDREN
}

enum ProductType {
  T_SHIRTS
  SHIRTS
  HOODIES
  JACKETS
  JEANS
  SHOES
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  // whole cents, so money is never a floating-point or decimal value in code
  priceCents  Int
  category    Category
  type        ProductType
  bestSeller  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  images ProductImage[]
  sizes  ProductSize[]
  colors ProductColor[]
  orderItems OrderItem[]

  @@index([category, type])
  @@index([createdAt])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // The object in the photo bucket. Empty for the sample catalog, whose pictures
  // are files of the app itself and are never deleted.
  key       String? @unique
  position  Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

// One row per size a product is sold in. Stock lives here, because a customer
// buys a size, not "a shirt". Labels are text because shoes use numbers.
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  stock     Int     @default(0)
  position  Int     @default(0)

  @@unique([productId, label])
  @@map("product_size")
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String

  @@index([productId])
  @@map("product_color")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  // ISO 3166-1 alpha-2; the countries we ship to are listed in src/lib/address/countries.ts
  country    String
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

// An order is a record of what was sold, to whom, and at what price, at one
// moment. It copies the product details and the delivery address instead of
// pointing at them, because products and saved addresses are edited and
// deleted while an order must stay as it was.
model Order {
  id             String        @id @default(cuid())
  // what the customer sees and quotes, for example CS-7K2M9QXD
  number         String        @unique
  // null once the account is deleted; the order itself is kept
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  // the Stripe Checkout session and payment of a card order
  stripeSessionId        String?       @unique
  stripePaymentIntentId  String?       @unique
  paidAt                 DateTime?
  refundedAt             DateTime?
  subtotalCents  Int
  shippingCents  Int
  totalCents     Int
  // one value per checkout attempt, so a repeated request returns the same order
  idempotencyKey String        @unique

  // the delivery address as it was at purchase
  shipName       String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipRegion     String?
  shipPostalCode String?
  shipCountry    String
  shipNotes      String?

  placedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cancelledAt    DateTime?

  items          OrderItem[]

  @@index([userId, placedAt])
  @@map("order")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // null if the product is deleted later; the copied fields below remain
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  size           String
  imageUrl       String?
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@map("order_item")
}

// Stripe sends each event at least once, and sends it again if we answer with
// an error. An event id in this table means its effects have been applied.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@map("stripe_event")
}

// What admins (and operators) changed, and when. An entry is written in the
// same transaction as the change it describes, so neither exists without the
// other. The actor is copied as text, because the account can be deleted.
model AuditLog {
  id         String   @id @default(cuid())
  // null for an operator's command, which has no account
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String
  // a dotted name such as order.ship or admin.grant
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}
